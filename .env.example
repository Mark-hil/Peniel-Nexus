# ==============================================================================
# Peniel Nexus — Environment Variables Configuration
# Copy this file to .env or .env.local and populate with your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Branding & Application Settings
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Peniel Nexus"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_DESCRIPTION="Fresh local market groceries delivered to your door in Ghana"
NEXT_PUBLIC_ORDER_PREFIX="PN"

# ------------------------------------------------------------------------------
# 2. Contact & Customer Support
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPPORT_EMAIL="support@penielnexus.com"
NEXT_PUBLIC_SUPPORT_PHONE="+233 24 555 0142"

# ------------------------------------------------------------------------------
# 3. Pricing & Fee Policies (GHS)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CURRENCY_CODE="GHS"
NEXT_PUBLIC_CURRENCY_SYMBOL="GHS"
# Fixed flat delivery fee in Ghana Cedis
NEXT_PUBLIC_DELIVERY_FEE=15
# Service fee rate charged on shopping budget (e.g., 0.10 = 10%)
NEXT_PUBLIC_SERVICE_FEE_RATE=0.10

# ------------------------------------------------------------------------------
# 4. Supabase Backend Infrastructure
# ------------------------------------------------------------------------------
# Get from: https://supabase.com/dashboard/project/<project-id>/settings/api
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
# Optional service-role key for backend administrative tasks:
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ------------------------------------------------------------------------------
# 5. Paystack Payments (Ghana Mobile Money & Card Integration)
# ------------------------------------------------------------------------------
# Get from: https://dashboard.paystack.com/#/settings/developer
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="your_test_paystack_public_key_here"
PAYSTACK_SECRET_KEY="your_test_paystack_secret_key_here"
# In production, swap with live credentials:
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="your_live_paystack_public_key_here"
# PAYSTACK_SECRET_KEY="your_live_paystack_secret_key_here"

# ------------------------------------------------------------------------------
# 6. Ghana SMS Gateways (Order Status & Delivery Alerts)
# ------------------------------------------------------------------------------
# Sender ID displayed on recipients' mobile phones (maximum 11 characters)
SMS_SENDER_ID="PenielNexus"

# Provider Option A: Arkesel SMS (Popular Ghana Gateway: https://arkesel.com)
ARKESE_API_KEY=""

# Provider Option B: Hubtel SMS (https://hubtel.com)
HUBTEL_CLIENT_ID=""
HUBTEL_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# 7. Security & Database Seeding
# ------------------------------------------------------------------------------
# Secret token required to trigger database seeding via /api/auth/seed in production
ADMIN_SEED_SECRET="your_super_secret_seed_key_here"

# ------------------------------------------------------------------------------
# 8. Demo Accounts (For Test / Showcase Environments)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_DEMO_CUSTOMER_EMAIL="customer@penielnexus.com"
NEXT_PUBLIC_DEMO_SHOPPER_EMAIL="shopper@penielnexus.com"
NEXT_PUBLIC_DEMO_RIDER_EMAIL="rider@penielnexus.com"
NEXT_PUBLIC_DEMO_ADMIN_EMAIL="admin@penielnexus.com"
NEXT_PUBLIC_DEMO_PASSWORD="PenielNexus#2026!SecureAuth"
